{
  "name": "api",
  "version": "0.1.0",
  "description": "Sentinel Support API service (Express + TypeORM)",
  "main": "dist/server.js",
  "types": "dist/types.d.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "migrate": "ts-node src/scripts/runMigrations.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "eval": "ts-node src/scripts/runEvals.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "helmet": "^6.2.0",
    "ioredis": "^5.8.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "stream-json": "^1.9.1",
    "supertest": "^7.1.4",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/helmet": "^4.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
